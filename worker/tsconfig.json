{
  // The Worker and the shared code it bundles, checked against the Workers
  // runtime types only: no DOM, no Node. `npm run typecheck:worker`.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "types": ["@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "worker-configuration.d.ts",
    "src",
    "test",
    "../src/engine",
    "../src/shared",
    "../src/challenge/score.ts",
    "../src/challenge/trees.ts",
    "../src/challenge/events.ts"
  ],
  "exclude": ["../src/**/*.test.ts", "../src/engine/testing.ts"]
}
